#!/usr/bin/env bash
# Deploy the lobby (lobby/, LOBBY.md) to a server over ssh, and update it later the same way.
#
#   bin/deploy-lobby ubuntu@203.0.113.5     get the lobby for the server (one static file: the latest release's
#                                           on GitHub, its checksum checked), copy it there with lobby/deploy/,
#                                           and run its setup: the lobby and Caddy (TLS) under systemd. Nothing
#                                           to install here or there. Run again to update.
#   bin/deploy-lobby                        the same, to the server it last deployed to, with the same key
#                                           (LOBBY_DEPLOY and LOBBY_DEPLOY_KEY in .env)
#   --version v3.0.0                        another release's lobby
#   --build                                 one built from this checkout instead (unreleased changes): needs Docker
#   -i ~/.ssh/key.pem                       the ssh key (else your ssh config and agent decide)
#   --status | --logs | --down              the server's lobby: its services and health, its log (follows it;
#                                           Ctrl-C to stop), or stop it
#
# Nothing needs setting: `bin/deploy-lobby` alone deploys basedverse's lobby (basedverse.app) to the server it last
# deployed to. Any setting comes from the environment, else this repository's .env, and is kept on the server once
# given (lobby/deploy/setup.sh says each one's default):
#   LOBBY_DOMAIN   the lobby's DNS name, pointing at the server (default basedverse.app): its certificate's, and
#                  what workrooms join (wss://LOBBY_DOMAIN/)
#   LOBBY_TITLE, LOBBY_MOTD, LOBBY_ADMINS (operators' keys, comma-separated), LOBBY_V3 (1: Visit 2.x workrooms too),
#   LOBBY_IP (the server's IPv4, served as well, for workrooms that still name the lobby by it), LOBBY_WORLD_SIZE (the
#   members a world takes; 50)
#
# The server: Linux with systemd (x86_64 or ARM64), a public address that LOBBY_DOMAIN points at, which you can ssh
# into and sudo on; ports 80 and 443 (TCP) and 7842 (UDP) open (lobby/README.md). Neither machine needs anything
# installed (but Docker here for --build). The server and key are remembered in this repository's .env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV="${BASEDVERSE_ENV:-$ROOT/.env}"
SSH_BIN="${DEPLOY_SSH:-ssh}"   # tests stand in a fake
RELEASES="https://github.com/sarmiena/Basedverse/releases"
die() { echo "deploy-lobby: $*" >&2; exit 1; }
usage() { sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit "${1:-0}"; }

command -v python3 >/dev/null 2>&1 || die "python3 is not installed"
[ -f "$ENV" ] || (umask 077; : > "$ENV")

# KEY -> its value in .env ('' when blank or missing): the last such line, quotes and trailing space off.
envval() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$ENV" | tail -n 1 | sed 's/[[:space:]]*$//' | tr -d '"'"'"; }
# KEY VALUE: rewrite KEY's line in .env (or add one), every other line as it was.
setenv() {
  python3 - "$ENV" "$1" "$2" <<'PY'
import re, sys
path, key, val = sys.argv[1:]
lines = open(path, encoding="utf-8").read().splitlines(True)
hit = [i for i, l in enumerate(lines) if re.match(r"\s*%s\s*=" % key, l)]
if hit:
    lines[hit[-1]] = "%s=%s\n" % (key, val)
else:
    lines.append(("" if not lines or lines[-1].endswith("\n") else "\n") + "%s=%s\n" % (key, val))
open(path, "w", encoding="utf-8").writelines(lines)
PY
}
# A lobby URL (ws:// or wss://) -> its /health answer ("ok 2 online"), or nothing.
lobby_health() {
  python3 - "$1" <<'PY' 2>/dev/null || true
import sys, urllib.request
u = sys.argv[1].replace("wss://", "https://", 1).replace("ws://", "http://", 1).rstrip("/") + "/health"
print(urllib.request.urlopen(u, timeout=5).read().decode().strip())
PY
}
# A shell word, quoted for the server's shell.
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

target="" key="" action="deploy" version="" build=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    -i) key="${2:?-i needs a key file}"; shift ;;
    --version) version="${2:?--version needs a release, like v3.0.0}"; shift ;;
    --build) build=1 ;;
    --status) action=status ;;
    --logs) action=logs ;;
    --down) action=down ;;
    -*) echo "deploy-lobby: unknown option $1" >&2; usage 2 ;;
    *) [ -z "$target" ] || die "one server at a time"; target="$1" ;;
  esac
  shift
done
target="${target:-$(envval LOBBY_DEPLOY)}"
key="${key:-$(envval LOBBY_DEPLOY_KEY)}"
REMOTE_DIR="$(envval LOBBY_DEPLOY_DIR)"   # a server set up under another name
REMOTE_DIR="${REMOTE_DIR:-basedverse-lobby}"
case "$REMOTE_DIR" in *[!A-Za-z0-9._-]*) die "LOBBY_DEPLOY_DIR $REMOTE_DIR is not a directory name" ;; esac
[ -n "$target" ] || { echo "deploy-lobby: which server? e.g. bin/deploy-lobby ubuntu@203.0.113.5" >&2; usage 2; }
case "$target" in *[!A-Za-z0-9@._:-]*) die "$target does not look like user@host" ;; esac
case "$version" in ""|v[0-9]*.[0-9]*.[0-9]*) ;; *) die "--version $version: a release, like v3.0.0" ;; esac
[ -n "$build" ] && [ -n "$version" ] && die "--build or --version, not both"
# The latest release, unless told another (or to build): GitHub's /releases/latest redirects to its tag. The tag is
# taken first, so the lobby and its SHA256SUMS come from one release even if another is published meanwhile.
latest_release() {
  local u; u="$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$RELEASES/latest")" || return 1
  u="${u##*/}"; case "$u" in v[0-9]*.[0-9]*.[0-9]*) printf '%s' "$u" ;; *) return 1 ;; esac
}

ssh_opts=(-o StrictHostKeyChecking=accept-new -o ConnectTimeout=15)
[ -n "$key" ] && ssh_opts+=(-i "$key")
tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
on_server() { "$SSH_BIN" "${ssh_opts[@]}" "$@"; }
setting() { local v="${!1:-}"; [ -n "$v" ] || v="$(envval "$1")"; printf '%s' "$v"; }
domain="$(setting LOBBY_DOMAIN)"; domain="${domain:-basedverse.app}"

case "$action" in
  status)
    on_server "$target" "systemctl --no-pager status basedverse-lobby basedverse-caddy | grep -E '^(●|  *(Active|Main PID):)'"
    up="$(lobby_health "wss://$domain/")"
    echo "wss://$domain/: ${up:-did not answer from here}"
    exit 0 ;;
  logs) exec "$SSH_BIN" "${ssh_opts[@]}" "${tty[@]}" "$target" "sudo journalctl -u basedverse-lobby -u basedverse-caddy -n 100 -f" ;;
  down) on_server "$target" "sudo systemctl stop basedverse-lobby basedverse-caddy"; exit 0 ;;
esac

# -- the lobby, for the server's architecture: a release's, or built here (--build, Docker) ---------------------
arch="$(on_server "$target" uname -m)" || die "could not reach $target (can you ssh to it? add -i KEY for a key file)"
case "$arch" in x86_64|amd64) rt=x86_64-unknown-linux-musl ;; aarch64|arm64) rt=aarch64-unknown-linux-musl ;; *) die "$target is $arch: x86_64 or ARM64 only" ;; esac
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
mkdir -p "$work/lobby"
if [ -z "$build" ]; then
  [ -n "$version" ] || version="$(latest_release)" || die "could not find the latest release ($RELEASES/latest): --version vX.Y.Z, or --build (Docker)"
  echo "getting the lobby of $version for $rt"
  curl -fsSL -o "$work/lobby.tar.gz" "$RELEASES/download/$version/lobby-$rt.tar.gz" \
    || die "$version has no lobby-$rt.tar.gz (not released yet? $RELEASES): wait for it, or --build (Docker) from this checkout"
  curl -fsSL -o "$work/SHA256SUMS" "$RELEASES/download/$version/SHA256SUMS" || die "$version has no SHA256SUMS"
  (cd "$work" && grep " lobby-$rt.tar.gz\$" SHA256SUMS | sed "s# lobby-$rt.tar.gz\$# lobby.tar.gz#" | sha256sum -c --quiet -) || die "its checksum does not match"
  tar -xzf "$work/lobby.tar.gz" -C "$work/lobby" lobby
else
  command -v docker >/dev/null 2>&1 || die "--build takes Docker here (without it: the latest release's lobby, the default)"
  here_arch="$(uname -m)"; case "$here_arch" in arm64) here_arch=aarch64 ;; amd64) here_arch=x86_64 ;; esac
  [ "${rt%%-*}" = "$here_arch" ] || die "$target is ${rt%%-*}, this machine $here_arch: --build only for a server like this machine (the latest release's lobby: the default)"
  echo "building the lobby for $rt (Docker; the first build takes a few minutes)"
  docker build -q -f "$ROOT/lobby/Dockerfile.dist" --build-arg TARGET="$rt" --target out --output "type=local,dest=$work/lobby" "$ROOT" >/dev/null
fi
cp -R "$ROOT/lobby/deploy" "$work/lobby/deploy"

echo "copying the lobby to $target:~/$REMOTE_DIR/lobby/"
tar -C "$work" -czf - lobby | on_server "$target" "mkdir -p ~/$REMOTE_DIR && tar -xzf - -C ~/$REMOTE_DIR" \
  || die "could not copy to $target"
setenv LOBBY_DEPLOY "$target"
setenv LOBBY_DEPLOY_KEY "$key"

echo "running its setup (the lobby and Caddy, under systemd; $domain's certificate the first time)"
vars="LOBBY_DOMAIN=$(q "$domain")"
for k in LOBBY_TITLE LOBBY_MOTD LOBBY_ADMINS LOBBY_V3 LOBBY_IP LOBBY_WORLD_SIZE; do
  v="$(setting "$k")"; [ -n "$v" ] && vars="$vars $k=$(q "$v")"
done
log="$(mktemp)"; trap 'rm -rf "$work" "$log"' EXIT
set +e
on_server "${tty[@]}" "$target" "sudo env $vars ~/$REMOTE_DIR/lobby/deploy/setup.sh ~/$REMOTE_DIR/lobby/lobby" | tee "$log"
status=${PIPESTATUS[0]}
set -e
[ "$status" = 0 ] || die "the setup on $target failed (above). bin/deploy-lobby --logs shows the lobby's log"

url="$(tr -d '\r' < "$log" | sed -n 's/^[[:space:]]*LOBBY_URL=//p' | tail -n 1)"
[ -n "$url" ] && setenv LOBBY_DEPLOY_URL "$url"   # for bin/setup
[ -n "$url" ] && printf '\nthe lobby: %s (its page: https://%s/)\neach workroom gives that as its lobby (VISIT_LOBBY)\n' "$url" "$domain"
exit 0
