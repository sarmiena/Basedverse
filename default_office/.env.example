# Copy to .env and fill in (git ignores .env: bin/start writes your GitHub token into it).
#
# Which GitHub project the board and the agents' tools point at.
#
# Read by seat/tools/forge.py (and the hooks that use it) and by the board container
# (forge/compose.yml loads it as env_file). A variable of the same name in the process
# environment wins over this file; a blank value counts as unset.
# Keep comments on their own lines: an inline `# ...` would become part of the value.

# The GitHub org or user that owns the repos.
REPO_OWNER=your-org

# The repos the board spans, comma- or space-separated. Blank = every repo of REPO_OWNER.
# With exactly one repo, a bare `#87` means that repo and `forge.py create -t ...` files there.
REPO_NAMES=your-repo

# The repo holding the RESUME (Up next) and AGENTS (roster) issues. Defaults to the one repo in
# REPO_NAMES. Both issues carry the `off-board` label, which must exist there first:
#   python3 ~/.claude/tools/forge.py newlabel off-board -d "Board bookkeeping, never a work item"
REPO_HOME=your-repo

# How rows are ordered inside each column: label names, comma-separated, highest first. A row
# carrying none of them is "unranked" and comes last.
REPO_RANK=severity: high, severity: medium, severity: low

# The board's columns (the kanban workflow) live in workflow.json beside this file: which rule puts
# a card in each column, which columns agents pick from, which ones a card can be dragged to.
# Point elsewhere with REPO_WORKFLOW=/path/to/workflow.json.

# A GitHub token with issues + pull requests read/write on the repos above.
# forge.py: blank here falls back to GH_TOKEN/GITHUB_TOKEN, then `gh auth token`.
# The board container has no `gh`, so it needs this set: REPO_TOKEN=<output of `gh auth token`>,
# or better, a fine-grained token limited to the repos above (see forge/README.md, "The token").
# GitHub's 5000 requests/hour is per ACCOUNT: every token of the same user shares it.
REPO_TOKEN=

# Where forge.py reaches the board server (kanban, Agent Room, messages).
REPO_BOARD_URL=http://localhost:3001
# The board's sign-in: the API key the agents' forge.py sends it (Authorization: Bearer). bin/start makes it once
# (auth-client key add agents) and writes it here; bin/auth key revoke agents, and the next bin/start makes another.
REPO_BOARD_KEY=

# GitHub's API and web addresses. Change only for GitHub Enterprise (https://<host>/api/v3).
REPO_URL=https://api.github.com
REPO_PUBLIC_URL=https://github.com

# The directories agents work in, comma-separated: each is a checkout of the repo above, or of another.
# `bin/init-agent` sets them all up (and clones one that does not exist yet); `bin/init-agent DIR`
# sets up one more and adds it here (the Agent Room's New agent does it too).
AGENTS=~/code/your-repo,~/code/your-repo-2,~/code/your-repo-3

# The other boards, `owner/repo` each, comma-separated: every GitHub repo an AGENTS directory is a checkout of, beside
# the repos above. bin/init-agent adds one when it sets up such a directory (and makes the labels workflow.json and
# REPO_RANK use there); the board shows it at its next poll. Their roster and Up next stay in REPO_HOME.
REPO_BOARDS=

# basedverse: the lobby and Visit, in a repository of their own. Blank is ../basedverse, beside this one;
# else its path (absolute, or relative to this repository). bin/start builds visit-client from it, and
# bin/deploy-lobby runs its deploy (which keeps the server it deploys to in basedverse's own .env).
BASEDVERSE=
# The lobby (basedverse's): other offices you can knock on and walk around with WASD, and who can walk
# around this one. With LOBBY_URL and LOBBY_NAME set, bin/start runs this office's visit-client (Visit's,
# in Docker, from basedverse), and the Agent Room's Visit panel is the lobby: offices, knocks, visitors, and
# Go offline / Go online. LOBBY_URL is the server's address, encrypted: wss://<its IP or name>
# (basedverse's lobby/README.md sets one up); blank: no lobby. LOBBY_NAME is your office's name there.
LOBBY_URL=
LOBBY_NAME=
# visit-client's port on 127.0.0.1, and how many may walk around this room at once (0-8).
VISIT_PORT=7401
VISIT_MAX_VISITORS=3
# bin/consoles' API key (an agent's herdr pane, opened from its name card in the room): it asks the board for the
# room's console calls with it, and listens on nothing. bin/start makes it once.
CONSOLES_KEY=

# The board from other devices on this machine's network: lan, and bin/start serves it over HTTPS (Caddy, its own
# certificate: trust .remote/board-ca.crt on each device once) at https://<this machine's LAN address>:3443 and
# https://<its name>.local:3443, to private addresses only. Blank: this machine only. (With Tailscale instead:
# leave it blank and run `tailscale serve --bg --https=9443 http://127.0.0.1:3002` once.) REMOTE_PORT: another port than
# 3443. With `tailscale` in REMOTE, bin/start serves it on your tailnet at https://<machine>.<tailnet>.ts.net:9443;
# REMOTE_TS_PORT: another port than 9443 (never 443, which a project's own dev server may need on this machine).
REMOTE=
REMOTE_PORT=
REMOTE_TS_PORT=

# The board's model (forge/board/llm.py), for its features that write words (the Agent Room's tarot reader): bring
# your own. The simplest: LLM_KEY, your Claude API key (sk-ant-..., from platform.claude.com), and nothing else; the
# board writes with Claude, claude-opus-5-5 unless LLM_MODEL names another. Or a model of your own, any OpenAI-compatible
# chat API (vLLM behind a gateway, Ollama, OpenAI's): LLM_URL its base, /v1 and all (chat requests miss without it);
# LLM_MODEL the model id, as `python3 forge/board/llm.py --models` lists them; LLM_KEY its bearer key, if it wants one.
# LLM_URL set means that API; blank, LLM_KEY is a Claude key. Neither: the tarot reader says she needs an LLM key.
# bin/board-restart after a change.
LLM_KEY=
LLM_URL=
LLM_MODEL=
